{
  "name": "@construct/sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "development": "./src/react/index.ts",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "development": "./src/next/index.ts",
      "default": "./dist/next/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@construct/authority-manifest": "file:../authority-manifest"
  }
}
