{
  "name": "@construct/authority-manifest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "development": "./dist/manifest/index.js",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/primitives/shared": {
      "types": "./dist/manifest/primitives/shared.d.ts",
      "development": "./dist/manifest/primitives/shared.js",
      "default": "./dist/manifest/primitives/shared.js"
    },
    "./manifest/primitives/product/*": {
      "types": "./dist/manifest/primitives/product/*.d.ts",
      "development": "./dist/manifest/primitives/product/*.js",
      "default": "./dist/manifest/primitives/product/*.js"
    },
    "./manifest/primitives/project/*": {
      "types": "./dist/manifest/primitives/project/*.d.ts",
      "development": "./dist/manifest/primitives/project/*.js",
      "default": "./dist/manifest/primitives/project/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  }
}
