CONSTRUCT_PLATFORM_API_URL=http://localhost:4100
CONSTRUCT_RUNTIME_TARGET_ID=testing-todo-app-production
CONSTRUCT_RUNTIME_TARGET_SECRET=local-development-runtime-target-secret
CONSTRUCT_ARTIFACT_ALLOWED_ORIGINS=http://localhost:4103
# Default off. Enable only on a managed host that accepts Platform-issued
# short-lived preview selectors in iframe fragments.
CONSTRUCT_RUNTIME_PREVIEWS_ENABLED=false
# Exact cookie-compatible parent used by postMessage and frame-ancestors.
CONSTRUCT_PLATFORM_WEB_ORIGIN=https://app-dev.thejesselee.com
# Optional non-secret build fingerprint; Vercel commit/deployment identity is
# used automatically when this value is absent.
CONSTRUCT_HOST_BUILD_ID=local-development
